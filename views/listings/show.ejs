<% layout("layouts/boilerplate") %>

<div class="container py-4" style="max-width: 820px;">

  <!-- Listing Header -->
  <div class="mb-3">
    <a href="/listings" class="text-decoration-none" style="color:#888; font-size:0.85rem;">
      <i class="fa-solid fa-arrow-left me-1"></i> Back to Listings
    </a>
  </div>

  <h2 style="font-weight:800; letter-spacing:-0.5px; color:#1a1a2e; margin-bottom:1.2rem;">
    <%= listing.title %>
  </h2>

  <!-- Image -->
  <img
    src="<%= listing.image.url %>"
    class="show-img mb-4"
    alt="listing_image"
  />

  <!-- Info Card -->
  <div style="background:#fff; border-radius:1rem; padding:1.8rem; box-shadow:0 4px 24px rgba(0,0,0,0.07); border:1px solid rgba(0,0,0,0.05); margin-bottom:1.5rem;">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
      <div>
        <p class="mb-1" style="font-size:1rem; color:#555;">
          <i class="fa-solid fa-user me-2" style="color:#fe424d;"></i>
          Hosted by <strong><%= listing.owner.username %></strong>
        </p>
        <p class="mb-1" style="color:#555;">
          <i class="fa-solid fa-location-dot me-2" style="color:#fe424d;"></i>
          <%= listing.location %>, <%= listing.country %>
        </p>
        <% if(listing.category) { %>
        <span style="background:rgba(254,66,77,0.09); color:#fe424d; font-size:0.78rem; font-weight:700; padding:0.25rem 0.75rem; border-radius:2rem; display:inline-block; margin-top:0.3rem;">
          <%= listing.category %>
        </span>
        <% } %>
      </div>

      <div style="text-align:right;">
        <div style="font-size:1.6rem; font-weight:800; color:#1a1a2e;">
          ₹<%= listing.price.toLocaleString("en-IN") %>
        </div>
        <div style="font-size:0.82rem; color:#888;">per night</div>
      </div>
    </div>

    <hr style="margin: 1.2rem 0; border-color:#f0f0f0;">

    <p style="color:#444; line-height:1.7; font-size:0.95rem;">
      <%= listing.description %>
    </p>

    <!-- Owner Buttons -->
    <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>
    <div class="d-flex gap-2 mt-3">
      <a href="/listings/<%= listing._id %>/edit" class="btn edt-btn">
        <i class="fa-solid fa-pen me-1"></i> Edit
      </a>
      <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-outline-danger" style="border-radius:2rem; font-weight:600; padding:0.6rem 1.4rem;">
          <i class="fa-solid fa-trash me-1"></i> Delete
        </button>
      </form>
    </div>
    <% } %>
  </div>

  <!-- Review Form -->
  <% if(currentUser) { %>
  <div style="background:#fff; border-radius:1rem; padding:1.8rem; box-shadow:0 4px 24px rgba(0,0,0,0.07); border:1px solid rgba(0,0,0,0.05); margin-bottom:1.5rem;">
    <h5 style="font-weight:700; margin-bottom:1.2rem;">Leave a Review</h5>

    <form action="/listings/<%= listing._id %>/reviews" method="POST">
      <div class="mb-3">
        <label class="form-label" style="font-weight:600; font-size:0.85rem; color:#555;">Rating</label>
        <fieldset class="starability-slot">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>

      <div class="mb-3">
        <label class="form-label" style="font-weight:600; font-size:0.85rem; color:#555;">Comment</label>
        <textarea name="review[comment]" rows="3" class="form-control" placeholder="Share your experience..." required></textarea>
      </div>

      <button class="btn add-btn" type="submit">
        <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
      </button>
    </form>
  </div>
  <% } %>

  <!-- All Reviews -->
  <% if(listing.reviews.length > 0) { %>
  <div>
    <h5 style="font-weight:700; margin-bottom:1rem;">
      <i class="fa-solid fa-star me-2" style="color:#fe424d;"></i>
      All Reviews (<%= listing.reviews.length %>)
    </h5>

    <div class="row g-3">
      <% for(let review of listing.reviews) { %>
      <div class="col-md-6">
        <div style="background:#fff; border-radius:1rem; padding:1.2rem 1.4rem; box-shadow:0 2px 12px rgba(0,0,0,0.06); border:1px solid rgba(0,0,0,0.05); height:100%;">
          <div class="d-flex justify-content-between align-items-start">
            <h6 style="font-weight:700; color:#1a1a2e; margin:0;">
              @<%= review.author.username %>
            </h6>
          </div>
          <p class="starability-result mt-1 mb-2" data-rating="<%= review.rating %>"></p>
          <p style="color:#555; font-size:0.9rem; line-height:1.6; margin-bottom:0.8rem;"><%= review.comment %></p>

          <% if(currentUser && review.author._id.equals(currentUser._id)) { %>
          <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn btn-sm" style="color:#fe424d; border:1px solid #fe424d; border-radius:1rem; font-size:0.78rem; padding:0.2rem 0.8rem; font-weight:600;">
              <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
          </form>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

</div>