<% layout("/layouts/boilerplate") %>

<div class="auth-wrapper">
  <div class="auth-card">

    <div class="auth-logo">
      <i class="fa-regular fa-compass"></i>
      <h2>Create Account</h2>
      <p>Join Staylio and start exploring</p>
    </div>

    <form method="post" action="/signup" novalidate class="needs-validation">

      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input id="username" name="username" placeholder="Choose a username" type="text"
          class="form-control" required>
        <div class="invalid-feedback">Please enter a valid username.</div>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email Address</label>
        <input id="email" name="email" placeholder="Enter your email" type="email"
          class="form-control" required>
        <div class="invalid-feedback">Please enter a valid email address.</div>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input id="password" name="password" placeholder="Create a password" type="password"
          class="form-control" required>
        <div class="invalid-feedback">Please enter a valid password.</div>
      </div>

      <button class="btn auth-submit-btn mt-2" type="submit">Create Account</button>

    </form>

    <div class="auth-footer-link">
      Already have an account? <a href="/login">Login</a>
    </div>

  </div>
</div>